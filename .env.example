KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
KITE_ACCESS_TOKEN=your_daily_access_token

# OAuth callback — must match the redirect URL in Kite Developer Console
KITE_REDIRECT_URL=http://localhost:3001/api/kite/callback

# Where to send the browser after a successful Kite login
KITE_APP_URL=http://localhost:5173

# Optional: API base URL shown in Connect Kite status (defaults to http://localhost:3001)
# KITE_API_BASE_URL=http://localhost:3001

# Optional: skip instrument lookup after first run
# KITE_INSTRUMENT_TOKEN=12345678

# Samco StockNote Trade API (execution only — Kite remains for market data)
SAMCO_API_KEY=
SAMCO_API_SECRET=
# Optional cached session token (refreshed via POST /session/token)
# SAMCO_SESSION_TOKEN=
SAMCO_BASE_URL=https://tradeapi.samco.in
SAMCO_PRODUCT_TYPE=MIS
# Samco placeOrder accepts L (limit) or SL (stop-limit). MKT is mapped to L.
SAMCO_ORDER_TYPE=L
SAMCO_DEFAULT_QUANTITY=100
SAMCO_ENTRY_PRICE_MIN=0
SAMCO_ENTRY_PRICE_MAX=3900
# Deprecated: use SAMCO_ENTRY_PRICE_MAX instead
# SAMCO_MAX_ENTRY_PRICE=3900
SAMCO_DRY_RUN=true
SAMCO_LIVE_TRADING_ENABLED=false
# Live placeOrder/squareOff only when Samco whoami srcIp matches this IP.
# Default is 223.181.63.52 (your Samco-registered static IP). Set empty to disable.
SAMCO_REQUIRED_STATIC_IP=223.181.63.52
SAMCO_EOD_SQUARE_OFF_START=15:00
SAMCO_EOD_SQUARE_OFF_END=15:15
# SAMCO_LEDGER_PATH=data/samco-ledger.json
